{
  "name": "site-backend",
  "version": "1.0.0",
  "description": "API Express/Sequelize do site",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "build": "sucrase ./src -d ./dist --transforms imports",
    "start": "node dist/server.js",
    "pm2:start": "npm run build && pm2 start ecosystem.config.js",
    "pm2:reload": "npm run build && pm2 reload ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "fix:pra": "node -r sucrase/register src/scripts/fixPraPara.js",
    "fix:pra:apply": "node -r sucrase/register src/scripts/fixPraPara.js --apply"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^24.10.1",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.31.0",
    "nodemon": "^3.1.9",
    "sequelize-cli": "^6.6.2",
    "sucrase": "^3.35.0"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mariadb": "^3.4.0",
    "multer": "^1.4.5-lts.1",
    "sequelize": "^6.37.5"
  }
}
