# Copie para /etc/nginx/sites-available/ e ajuste server_name / porta.
# A API escuta em 0.0.0.0:3018 (HOST e PORT do .env).

upstream site_backend {
  server 127.0.0.1:3018;
  keepalive 32;
}

server {
  listen 80;
  server_name api.seudominio.com.br;

  client_max_body_size 50M;

  location /health {
    proxy_pass http://site_backend/health;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
  }

  location / {
    proxy_pass http://site_backend;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
  }
}
